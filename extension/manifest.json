{
  "manifest_version": 3,
  "name": "SwissQRRechnung",
  "version": "1.0.0",
  "description": "Erstellt Schweizer QR-Rechnungen direkt aus dem VeruA-Intranet",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SwissQRRechnung - Einstellungen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "swissqrrechnung@spitex.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.verua.org/*"
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.verua.org/start_abrechnung.php*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "dist/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
