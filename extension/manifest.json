{
  "manifest_version": 3,
  "name": "SwissQRRechnung",
  "version": "1.0.0",
  "description": "Erstellt Schweizer QR-Rechnungen direkt aus dem VeruA-Intranet",
  "browser_specific_settings": {
    "gecko": {
      "id": "swissqrrechnung@spitex.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.verua.org/*"
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.verua.org/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "dist/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
