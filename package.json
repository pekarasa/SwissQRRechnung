{
  "name": "swissqrrechnung",
  "version": "1.0.1",
  "description": "Firefox-Erweiterung: Erstellt Schweizer QR-Rechnungen direkt aus dem VeruA-Intranet (`https://*.verua.org`). Stamm- und Rechnungsdaten werden im Browser geladen, zusammengeführt und als PDF lokal erzeugt.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node build.js",
    "lint": "web-ext lint",
    "package": "node build.js && web-ext build --config web-ext-config.cjs",
    "start": "node build.js && web-ext run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^10.14.0",
    "pdf-parse": "^1.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.7",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "swissqrbill": "^4.4.3",
    "xlsx": "^0.18.5"
  }
}
