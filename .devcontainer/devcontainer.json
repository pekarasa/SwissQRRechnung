{
	"name": "SQR",
	"build": {
		"dockerfile": "devenv.dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"EditorConfig.EditorConfig"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.analysis.typeCheckingMode": "basic"
			}
		}
	},
	"remoteUser": "vscode"
}
