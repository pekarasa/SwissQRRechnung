{
	"name": "SQR",
    // Liest die Variablen aus der .env-Datei:
    "runArgs": [
        "--env-file", ".devcontainer/.env"
    ],
    // Das Zertifikat muss als Datei trotzdem in den Container gemountet werden:
    "mounts": [
        "source=${localEnv:USERPROFILE}/ThalesCerts.pem,target=/usr/local/share/ca-certificates/ThalesCerts.pem,type=bind,readonly"
    ],
	"build": {
		"dockerfile": "devenv.dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"actboy168.tasks",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"EditorConfig.EditorConfig",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.analysis.typeCheckingMode": "basic"
			}
		}
	},
	"postCreateCommand": "if [ -f extension/package.json ]; then npm install --prefix extension; fi",
	"remoteUser": "vscode"
}
